events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # Upstream FastAPI ASGI cluster
    upstream nexus_backend {
        server nexus-backend:8000;
    }

    server {
        listen 80;
        server_name localhost;

        # Web Dashboard & Static Files Proxy
        location / {
            proxy_pass http://nexus_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # WebSocket Gateway Upgrade Router
        location /ws/ {
            proxy_pass http://nexus_backend/ws/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 86400s;
        }

        # Server-Sent Events (SSE) AI Streaming Proxy
        location /api/v1/ai/stream {
            proxy_pass http://nexus_backend/api/v1/ai/stream;
            proxy_set_header Host $host;
            proxy_set_header Connection '';
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding off;
        }
    }
}
